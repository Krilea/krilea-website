# Копирайте този файл като .env за локална разработка (по избор — формата за
# абонамент работи и без него, но ще показва грешка при изпращане).
# В производствена среда стойностите се въвеждат в Netlify → Site configuration
# → Environment variables (виж README.md).

# MailerLite → Integrations → API (генерира се от акаунта ви в MailerLite)
MAILERLITE_API_KEY=

# MailerLite → Subscribers → Groups → отворете групата и вижте ID-то в адреса
MAILERLITE_GROUP_ID=

# Cloudflare Web Analytics → Add a site → копирайте само token стойността
# от полето "data-cf-beacon". По избор — статистиката е изключена, докато
# полето е празно.
PUBLIC_CF_BEACON_TOKEN=
