---
import { Image } from 'astro:assets';
import branch from '../../assets/icons/ornament-branch.png';

interface Props {
  onDark?: boolean;
  class?: string;
}
const { onDark = false, class: className = '' } = Astro.props;
---
<div class={`botanical-divider ${className}`} data-on-dark={onDark}>
  <span class="botanical-divider__line"></span>
  <Image src={branch} alt="" width={70} height={Math.round((70 * branch.height) / branch.width)} class="botanical-divider__branch" />
  <span class="botanical-divider__line"></span>
</div>

<style>
  .botanical-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    width: 100%;
    max-width: 22rem;
    margin-inline: auto;
  }

  .botanical-divider__line {
    flex: 1 1 auto;
    height: 1px;
    background: var(--color-herbal);
    opacity: 0.7;
  }

  .botanical-divider[data-on-dark='true'] .botanical-divider__line {
    background: var(--color-herbal-soft);
    opacity: 0.6;
  }

  .botanical-divider__branch {
    flex: 0 0 auto;
    opacity: 0.9;
  }

  .botanical-divider[data-on-dark='true'] .botanical-divider__branch {
    opacity: 0.85;
    filter: brightness(1.3);
  }
</style>
