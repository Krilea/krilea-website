---
import { Image } from 'astro:assets';
import ornamentGreen from '../../assets/icons/ornament-green.png';
import ornamentPlatinum from '../../assets/icons/ornament-platinum.png';

interface Props {
  onDark?: boolean;
  class?: string;
}
const { onDark = false, class: className = '' } = Astro.props;
const src = onDark ? ornamentPlatinum : ornamentGreen;
---

<div class={`botanical-divider ${className}`}>
  <Image src={src} alt="" width={220} loading="lazy" />
</div>

<style>
  .botanical-divider {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .botanical-divider :global(img) {
    width: clamp(160px, 22vw, 260px);
    height: auto;
    object-fit: contain;
  }
</style>
