---
interface Props {
  name: 'instagram' | 'facebook' | 'tiktok' | 'pinterest' | 'youtube';
  class?: string;
}
const { name, class: className = '' } = Astro.props;
---
<svg
  class={className}
  width="19"
  height="19"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  {name === 'instagram' && (
    <>
      <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'facebook' && (
    <path d="M14 21v-8h2.7l.4-3.2H14V7.7c0-.93.26-1.56 1.6-1.56H17V3.14C16.72 3.1 15.77 3 14.66 3 12.35 3 10.76 4.4 10.76 7.1v2.7H8v3.2h2.76V21Z" />
  )}
  {name === 'tiktok' && (
    <path d="M14 3.5c.5 2 2.1 3.3 4.3 3.5v3c-1.6 0-3-.5-4.3-1.4v6.6a5.2 5.2 0 1 1-5.2-5.2c.3 0 .6 0 .9.07v3.03a2.2 2.2 0 1 0 1.5 2.1V3.5Z" />
  )}
  {name === 'pinterest' && (
    <path d="M11 21c-.4-1.4-.7-2.7-1-4.1-.3 1.3-1.1 3.1-1.9 4.1M4 12a8 8 0 1 1 12.5 6.6c-1.7.4-3-.3-2.5-2.2l.9-3.7c.2-1 -.2-2.2-1.4-2.2-1.7 0-2.8 1.7-2.4 3.8L11.5 18" />
  )}
  {name === 'youtube' && (
    <>
      <rect x="3" y="6" width="18" height="12" rx="4" />
      <path d="M10.5 9.7 15 12l-4.5 2.3Z" />
    </>
  )}
</svg>
