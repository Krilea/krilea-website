---
import { SITE } from '../config/site';
import BotanicalDivider from './icons/BotanicalDivider.astro';
---

<section id="brand-essence" class="section brand-essence">
  <div class="container container--narrow brand-essence__inner">
    <BotanicalDivider />
    <p class="brand-essence__text">{SITE.brandEssence}</p>
  </div>
</section>

<style>
  .brand-essence__inner {
    text-align: center;
  }

  .brand-essence__text {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.55rem, 2.9vw, 2.25rem);
    line-height: 1.6;
    color: var(--color-forest);
    margin: 1.8rem 0 0;
  }
</style>
