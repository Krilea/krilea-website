---
import ValueIcon from './icons/ValueIcon.astro';
import BotanicalDivider from './icons/BotanicalDivider.astro';

const values = [
  { label: 'Натурално', variant: 1 as const },
  { label: 'Чисто', variant: 2 as const },
  { label: 'Хармония', variant: 3 as const },
  { label: 'Автентичност', variant: 4 as const },
  { label: 'Устойчивост', variant: 5 as const },
];
---

<section class="section values">
  <div class="container">
    <BotanicalDivider class="values__divider" />
    <p class="eyebrow values__eyebrow">Ценности</p>
    <ul class="values__list">
      {values.map((v) => (
        <li>
          <ValueIcon variant={v.variant} class="values__icon" />
          <span>{v.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .values {
    text-align: center;
  }

  .values__divider {
    margin-bottom: 1.8rem;
  }

  .values__eyebrow {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .values__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .values__list li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
  }

  .values__list span {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-forest);
  }

  :global(.values__icon) {
    height: 44px;
    width: auto;
  }
</style>
