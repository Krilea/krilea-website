---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  updated: string;
}

const { title, description, updated } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <header class="section legal-header">
    <div class="container container--narrow">
      <p class="eyebrow legal-header__eyebrow">Правна информация</p>
      <h1>{title}</h1>
      <p class="legal-header__updated">Последна актуализация: {updated}</p>
    </div>
  </header>

  <section class="section legal-body">
    <div class="container container--narrow prose">
      <slot />
    </div>
  </section>
</BaseLayout>

<style>
  .legal-header {
    text-align: center;
    padding-bottom: 1rem;
  }

  .legal-header__eyebrow {
    text-align: center;
    margin-bottom: 1rem;
  }

  .legal-header__updated {
    font-size: 0.85rem;
    color: var(--color-sage);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .legal-body {
    padding-top: 1rem;
  }

  .prose {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-ink);
  }

  .prose :global(h2) {
    font-size: 1.4rem;
    margin-top: 2.2em;
  }

  .prose :global(h3) {
    font-size: 1.1rem;
    margin-top: 1.8em;
  }

  .prose :global(p) {
    margin-bottom: 1.2em;
  }

  .prose :global(ul) {
    margin-bottom: 1.2em;
    padding-left: 1.4em;
  }

  .prose :global(li) {
    margin-bottom: 0.5em;
  }

  .prose :global(a) {
    color: var(--color-forest);
  }

  .prose :global(strong) {
    color: var(--color-forest);
  }
</style>
