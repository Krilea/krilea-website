---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BotanicalDivider from '../../components/icons/BotanicalDivider.astro';
---

<BaseLayout title="Благодарим ви" description="Съобщението ви беше получено успешно." noindex>
  <section class="section thanks">
    <div class="container container--narrow">
      <BotanicalDivider />
      <h1>Благодарим ви</h1>
      <p>
        Съобщението ви беше получено успешно. Ще ви отговорим възможно най-скоро на посочения от вас имейл адрес.
      </p>
      <a href="/" class="btn">Към началото</a>
    </div>
  </section>
</BaseLayout>

<style>
  .thanks {
    text-align: center;
    padding-block: clamp(5rem, 12vw, 9rem);
  }

  .thanks h1 {
    margin-top: 1.8rem;
  }

  .thanks p {
    max-width: 30rem;
    margin-inline: auto 2rem;
    color: #4a544b;
  }
</style>
